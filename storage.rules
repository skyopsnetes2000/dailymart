rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check for admin or the main admin
    function isAuthorizedAdmin() {
      let email = request.auth.token.email;
      let roles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
      return email == 'dhandesaurav52@gmail.com' || 'admin' in roles;
    }

    // Publicly readable folders for images
    match /products/{allPaths=**} {
      allow read;
      allow write: if isAuthorizedAdmin();
    }
    match /categories/{allPaths=**} {
      allow read;
      allow write: if isAuthorizedAdmin();
    }
    match /recipes/{allPaths=**} {
      allow read;
      allow write: if isAuthorizedAdmin();
    }
     match /appearance/{allPaths=**} {
      allow read;
      allow write: if isAuthorizedAdmin();
    }

    // Shop requests can be written by the user who owns the folder.
    // Admins can read them.
    match /shop-requests/{userId}/{allPaths=**} {
      allow read: if isAuthorizedAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other reads and writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
