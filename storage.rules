rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if a user is authenticated
    function isAuthed() {
      return request.auth != null;
    }

    // Publicly readable folders
    match /{folder:(categories|products|recipes|appearance)}/{allPaths=**} {
      allow read;
      allow write: if isAuthed();
    }

    // Shop requests can be written by any authenticated user, but not read publicly
    match /shop-requests/{userId}/{allPaths=**} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
