rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }
    
    function isAdmin() {
      // You must connect this to your Firestore database for it to work
      return exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    // PUBLIC READ: Allow anyone to read images for products, categories, recipes, and appearance.
    match /{folder:regex(products|categories|recipes|appearance)}/{allPaths=**} {
      allow read: if true;
    }
    
    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
