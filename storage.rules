rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files.
    // This is necessary for anyone to be able to see product/category/etc images.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Restrict write access to authenticated users for specific folders.
    // This prevents anonymous users from uploading files.
    match /categories/{fileName} {
      allow write: if request.auth != null;
    }
    match /products/{fileName} {
      allow write: if request.auth != null;
    }
    match /recipes/{fileName} {
      allow write: if request.auth != null;
    }
    match /appearance/{fileName} {
      allow write: if request.auth != null;
    }
    
    // Anyone can submit a shop request, so they need to be able to upload documents.
    match /shop-requests/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}