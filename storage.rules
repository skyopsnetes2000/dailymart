rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default to denying all access
    // match /{allPaths=**} {
    //   allow read, write: if false;
    // }

    // Publicly readable folders for images
    match /appearance/{imageId} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /categories/{imageId} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /products/{imageId} {
      allow read;
      allow write: if request.auth != null;
    }

    match /recipes/{imageId} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
