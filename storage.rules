rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check for authentication
    function isAuth() {
      return request.auth != null;
    }

    // Allow public read access to image folders
    match /products/{allPaths=**} {
      allow read;
    }

    match /categories/{allPaths=**} {
      allow read;
    }

    match /recipes/{allPaths=**} {
      allow read;
    }

    match /appearance/{allPaths=**} {
      allow read;
    }

    // Allow authenticated users (admins) to write to image folders
    match /{folder}/{allPaths=**}
      where folder IN ['products', 'categories', 'recipes', 'appearance'] {
        allow write: if isAuth();
    }
  }
}
