rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isMainAdmin() {
      return request.auth != null && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdminOrSeller() {
      return request.auth != null && (
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
        'seller' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
      );
    }
    
    function isAdmin() {
      return isMainAdmin() || (request.auth != null && 'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles);
    }

    // --- Public Collections (Read-Only for Everyone) ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdminOrSeller() || isMainAdmin();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdminOrSeller() || isMainAdmin();
    }
    
    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // --- User-Specific Collections ---
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if request.auth != null;
      // Admins can read user data, but not modify it directly (roles are handled by specific functions)
      allow get: if isAdmin();
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Orders ---
    match /orders/{orderId} {
        allow create: if isOwner(request.resource.data.userId);
        allow read: if isOwner(resource.data.userId) || isAdminOrSeller() || isMainAdmin();
        allow update: if (isAdminOrSeller() || isMainAdmin()) || 
                           (isOwner(resource.data.userId) && request.resource.data.status == 'Return Requested');
    }

    // --- Admin/Seller Only Collections ---
    match /shopRequests/{requestId} {
        allow read: if isAdmin() || isOwner(request.resource.data.userId);
        allow create: if isOwner(request.resource.data.userId);
        allow update: if isAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
    
    match /settings/{settingId} {
        allow read: if true;
        allow write: if isAdmin();
    }
  }
}
