rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isMainAdmin() {
      return isAuth() && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }
    
    function getUserRoles() {
      // This get() can only succeed if the rules for the `users` collection allow it.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isAdmin() {
      return isAuth() && (isMainAdmin() || getUserRoles().hasAny(['admin']));
    }
    
    function isSeller() {
        return isAuth() && (isAdmin() || getUserRoles().hasAny(['seller']));
    }

    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isSeller();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSeller();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isSeller();
    }
    
    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      // A user can read their own document (to get roles). Admins can read any.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Only admins can create/update user roles.
      allow write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /orders/{orderId} {
        allow create: if isAuth(); // Allow any authenticated user to create an order
        allow read: if isOwner(resource.data.userId) || isSeller();
        allow update: if isSeller(); // Only sellers can update order status
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write, delete: if isOwner(userId);
    }
    
    // Admin & Seller specific collections
    match /shopRequests/{requestId} {
      // Users can read their own request, admins can read any.
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth();
      allow update: if isAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}
