
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Public collections, readable by anyone, writable only by admin (implicit)
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Should be handled by backend/admin logic
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
     match /appearance/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users can only access their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Orders: Users can create orders, and can read/update their own.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // By default, deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
