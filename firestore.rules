rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isMainAdmin();
      allow write: if isOwner(userId) || isMainAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow get, update, delete: if (isAuth() && request.auth.uid == resource.data.userId) || isMainAdmin();
      allow create: if isAuth();
      allow list: if isAuth() || isMainAdmin();
    }
    
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }
    
    match /settings/{docId} {
        allow read, write: if isMainAdmin();
    }

    match /shopRequests/{requestId} {
      allow read, list: if isMainAdmin() || (isAuth() && request.query.offset == 0);
      allow create: if isAuth();
      allow update: if isMainAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isMainAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isMainAdmin();
    }
  }
}
