rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAuth() {
      return request.auth != null;
    }

    // Rules for products
    match /products/{productId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    // Rules for categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    // Rules for appearance settings
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }
    
    // Rules for shop requests
    match /shopRequests/{requestId} {
      allow read: if isMainAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isMainAdmin();
    }

    // Rules for user-specific data (carts, addresses)
    match /users/{userId}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Rules for main user collection
    match /users/{userId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow update: if isMainAdmin(); // For role updates
    }
    
    // Rules for orders
    match /orders/{orderId} {
        allow read, create, update: if isAuth() && request.auth.uid == resource.data.userId;
        allow list, delete: if isMainAdmin();
    }

    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
