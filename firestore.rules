rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    // User-specific data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read any user document
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
      // Allow user creation
      allow create: if request.auth != null;
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders can be created by users, but only read by the user or an admin/seller
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
      allow update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
    }
    
    // Seller and Employee management by Admins only
    match /shopRequests/{requestId} {
        allow read, write, create: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
        allow create: if request.auth != null; // Users can submit requests
    }
    
    match /employees/{employeeId} {
      allow read, write, create, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    match /teams/{teamId} {
        allow read, write, create, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    match /settings/{settingId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
  }
}