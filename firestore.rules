rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Allow read/write if the user has 'admin' or 'seller' role.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']);
    }

    function isMainAdmin() {
      // Allow write to user roles only if user is 'admin'.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    // Public read collections
    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /recipes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Carts
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders
    match /orders/{orderId} {
      allow read, create: if isOwner(resource.data.userId);
      allow update: if isAdmin();
    }

    // Users
    match /users/{userId} {
      // Any authenticated user can read their own document.
      // An admin can read any user document.
      allow read: if isOwner(userId) || isAdmin();

      // An owner can update their document, but cannot change roles.
      // A main admin can update any part of the document, including roles.
      allow write: if (isOwner(userId) && !('roles' in request.resource.data)) || isMainAdmin();
    }
  }
}
