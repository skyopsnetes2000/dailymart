rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId && !('roles' in request.resource.data);
      allow update: if request.auth.uid == userId && !('roles' in request.resource.data);
      allow create: if request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    match /carts/{userId} {
        allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
        allow read, create: if request.auth.uid == resource.data.userId;
        allow list, update: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}