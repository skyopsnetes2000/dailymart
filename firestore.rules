rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Public Collections (Products, Categories, Appearance) ---
    // Anyone can read this data (for the public-facing store),
    // but only authenticated users can write (for the admin panel).
    match /{collection}/{docId} where collection in ['products', 'categories', 'appearance'] {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- Orders Collection ---
    // Users can only read or create their own orders.
    // Admins can read all orders, but cannot create them.
    // Updates are handled by specific logic (e.g. status changes by admin).
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated(); // More granular control should be in backend logic
      allow delete: if false; // Prevent accidental deletion
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
