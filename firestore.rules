rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      let uid = request.auth.uid;
      let roles = get(/databases/$(database)/documents/users/$(uid)).data.roles;
      return isAuthed() && (roles.hasAny(['admin', 'seller']));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !('roles' in request.resource.data)) || isAdmin();
    }
    
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}
