rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isRole(role) {
      return isSignedIn() && role in getRoles();
    }
    
    function isRoleOr(role1, role2) {
       return isSignedIn() && (role1 in getRoles() || role2 in getRoles());
    }

    // --- Collections Rules ---
    
    // Public collections (anyone can read)
    match /products/{productId} {
      allow read: if true;
      allow write: if isRoleOr('admin', 'seller');
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isRole('admin');
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isRole('admin');
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isRole('admin');
    }

    // User-specific data
    match /users/{userId} {
      allow read: if isOwner(userId) || isRole('admin');
      allow write: if isOwner(userId); // Users can create their own doc on signup
      allow create: if true; 
    }
    
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }
    
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read, update: if isOwner(resource.data.userId) || isRoleOr('admin', 'seller');
      allow create: if isSignedIn();
    }
    
    // Admin-only collections
    match /employees/{employeeId} {
      allow read, write: if isRole('admin');
    }
    
    match /teams/{teamId} {
      allow read, write: if isRole('admin');
    }
    
    match /settings/{settingId} {
      allow read, write: if isRole('admin');
    }

    match /shopRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isRole('admin');
      allow create: if isSignedIn();
      allow update: if isRole('admin');
    }
  }
}
