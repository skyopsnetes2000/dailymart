rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }
    
    function isSeller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }

    function isAdmin() {
      // Check for 'admin' role in the user's document.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    function isAuthorizedAdmin() {
      return isMainAdmin() || isAdmin();
    }
    
    // PUBLIC: Anyone can read these collections.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // USER-SPECIFIC: Users can only access their own data.
    match /users/{userId} {
      // Critical fix: Allow users to read their own user document to check roles.
      allow read: if request.auth.uid == userId;
      allow create, update: if request.auth.uid == userId;
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAuthorizedAdmin() || isSeller();
      allow create: if request.auth != null;
      allow update: if isAuthorizedAdmin() || isSeller();
    }

    // ADMIN & SELLER ONLY
    match /shopRequests/{requestId} {
      allow read: if get(/databases/$(database)/documents/shopRequests/$(requestId)).data.userId == request.auth.uid || isAuthorizedAdmin();
      allow create: if request.auth != null;
      allow update: if isAuthorizedAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAuthorizedAdmin();
    }
    match /teams/{teamId} {
        allow read, write: if isAuthorizedAdmin();
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
