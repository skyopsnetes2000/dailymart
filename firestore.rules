rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }
    
    function isAdmin() {
      return isSignedIn() && ('admin' in getRoles());
    }

    function isSeller() {
      return isSignedIn() && ('seller' in getRoles());
    }
    
    // --- Collection Rules ---

    // Users can be read by anyone, but only the owner or an admin can write.
    match /users/{userId} {
      allow read;
      allow write: if isOwner(userId) || isAdmin() || isMainAdmin();
    }

    // Public collections readable by anyone
    match /products/{productId} {
      allow read;
      allow write: if isAdmin() || isSeller() || isMainAdmin();
    }
    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin() || isMainAdmin();
    }
    match /recipes/{recipeId} {
      allow read;
      allow write: if isAdmin() || isMainAdmin();
    }
     match /appearance/{docId} {
      allow read;
      allow write: if isAdmin() || isMainAdmin();
    }
    match /settings/{docId} {
      allow read;
      allow write: if isAdmin() || isMainAdmin();
    }

    // User-specific data
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /orders/{orderId} {
      allow read: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSeller() || isMainAdmin() || (isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId));
    }
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }

    // Admin/Seller only collections
    match /employees/{employeeId} {
      allow read, write: if isAdmin() || isMainAdmin();
    }
    match /teams/{teamId} {
      allow read, write: if isAdmin() || isMainAdmin();
    }

    // Shop Requests
    match /shopRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isMainAdmin() || isOwner(resource.data.userId);
      allow update: if isAdmin() || isMainAdmin();
    }
  }
}
