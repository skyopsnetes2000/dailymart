rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    function isSeller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }

    function isAuthorizedAdmin() {
      return isMainAdmin() || isAdmin();
    }
    
    function isAuthorizedSeller() {
      return isAuthorizedAdmin() || isSeller();
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId && (isAuthorizedSeller() || isAuthorizedAdmin()) || isAuthorizedAdmin();
      allow write: if isAuthorizedAdmin();
    }
    
    match /users/{userId}/addresses/{addressId} {
      allow read, write, delete: if request.auth.uid == userId;
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedSeller();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthorizedSeller();
    }

    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || isAuthorizedSeller();
      allow create: if request.auth.uid != null;
      allow update: if isAuthorizedSeller();
    }
    
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /shopRequests/{requestId} {
      allow read: if request.auth.uid == resource.data.userId || isAuthorizedAdmin();
      allow create: if request.auth.uid != null;
      allow update: if isAuthorizedAdmin();
    }

    match /employees/{employeeId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /settings/{settingId} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
