rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      // Check if the user has an 'admin' or 'super-admin' role.
      // Use '.get' which returns a resource that might not exist, then check .data.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'super-admin']);
    }

    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // User-specific data
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      // Allow a user to create their own user document during signup
      allow create: if request.auth.uid == userId;
    }

    match /users/{userId}/addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
    }
    
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /orders/{orderId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update: if isAdmin();
    }

    // Admin & shop-specific collections
    match /shopRequests/{requestId} {
      // Any authenticated user can create a request.
      allow create: if request.auth != null;
      // Only admins can read or update (approve/reject) requests.
      allow read, update: if isAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}
