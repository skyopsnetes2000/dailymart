rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }
    
    function isSellerOrAdmin() {
      return isSignedIn() && (hasRole('admin') || hasRole('seller') || isMainAdmin());
    }
    
    function isAdmin() {
      return isSignedIn() && (hasRole('admin') || isMainAdmin());
    }

    // --- Public Collections ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isSellerOrAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isSellerOrAdmin();
    }
    
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
       allow read: if true;
       allow write: if isAdmin();
    }

    // --- User-specific Collections ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      allow create: if true;
    }
    
    match /users/{userId}/addresses/{addressId} {
        allow read, write, delete: if isOwner(userId);
    }
    
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if isOwner(request.resource.data.userId) || isSellerOrAdmin();
      allow create: if isSignedIn();
      allow update: if isSellerOrAdmin() || (isSignedIn() && request.resource.data.status == 'Return Requested');
    }
    
    // --- Admin-only Collections ---
    match /shopRequests/{requestId} {
        allow read, update: if isAdmin();
        allow create: if isSignedIn();
    }
    
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }
  }
}
