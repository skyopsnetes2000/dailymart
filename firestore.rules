
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']));
    }

    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
        allow read;
        allow write: if isAdmin();
    }

    match /appearance/{docId} {
        allow read;
        allow write: if isAdmin();
    }
    
    match /settings/{docId} {
        allow read;
        allow write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId && !('roles' in request.resource.data) || (isAdmin() && request.auth.uid != userId);
    }
  }
}
