
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Hardcoded admin email OR a user with the 'admin' role in their user document
      return request.auth.token.email == 'dhandesaurav52@gmail.com' ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']));
    }

    // PUBLIC COLLECTIONS: Readable by anyone, writable only by admin
    match /{collectionName}/{docId} where collectionName in ['products', 'categories', 'recipes', 'appearance', 'settings'] {
      allow read;
      allow write: if isAdmin();
    }

    // CARTS: Users can only manage their own cart
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // ORDERS: Users can read their own orders. Admins can read/write all orders.
    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
    }

    // USERS: Users manage their own profile, but cannot change roles. Admins can manage any.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !('roles' in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
