
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      let isEmail = request.auth.token.email == 'dhandesaurav52@gmail.com';
      let hasRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
      return isEmail || hasRole;
    }

    // Publicly readable collections
    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }
    match /recipes/{recipeId} {
      allow read;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
      allow read;
      allow write: if isAdmin();
    }
    
    // User-specific collections
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if (request.auth.uid == userId && !("roles" in request.resource.data)) || isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAdmin();
    }
    
     match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
        allow read, write: if isAdmin();
    }
  }
}
