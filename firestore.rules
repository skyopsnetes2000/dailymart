
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      let email = request.auth.token.email;
      let roles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
      return (email == 'dhandesaurav52@gmail.com') || ('admin' in roles && roles.admin == true) || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']));
    }

    // PUBLIC: Product and category data
    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }
    match /recipes/{recipeId} {
      allow read;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
        allow read;
        allow write: if isAdmin();
    }

    // USER-SPECIFIC: Carts, orders, and user profile
    match /carts/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read, create: if isAuthed();
      allow update: if isAuthed() || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && request.auth.uid == userId && !('roles' in request.resource.data);
      allow delete: if isAuthed() && request.auth.uid == userId;

      match /addresses/{addressId} {
        allow read, write: if isAuthed() && request.auth.uid == userId;
      }
    }
    
    // ADMIN-ONLY:
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }
    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
