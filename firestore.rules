rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions for auth checking
    function isMainAdmin() {
      return request.auth != null && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    function isSeller() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }
    
    function isAuthorizedAdmin() {
      return isMainAdmin() || isAdmin();
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isAuthorizedAdmin();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /settings/{settingId} {
        allow read, write: if isAuthorizedAdmin();
    }
    
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId} {
        allow read: if isOwner(userId) || isAuthorizedAdmin();
        allow create: if request.auth != null; // Anyone can create their own user doc on signup
        allow update: if isOwner(userId) || isAuthorizedAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAuthorizedAdmin() || isSeller();
      allow create: if request.auth != null; // Allow authenticated users to create orders
      allow update: if isAuthorizedAdmin() || isSeller() || (isOwner(resource.data.userId) && request.resource.data.status == 'Return Requested');
    }
    
    match /users/{userId}/addresses/{addressId} {
        allow read, write: if isOwner(userId);
    }
    
    match /shopRequests/{requestId} {
        allow read: if isAuthorizedAdmin() || isOwner(resource.data.userId);
        allow create: if request.auth != null;
        allow update: if isAuthorizedAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAuthorizedAdmin();
    }
  }
}