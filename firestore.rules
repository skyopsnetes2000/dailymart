rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMainAdmin() {
      // The main admin's email, who has ultimate power.
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isUser(userId) {
        return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has the 'admin' role in their user document.
      return isAuth() && ('admin' in getUserData(request.auth.uid).roles);
    }
    
    // --- Collection Rules ---

    // Publicly readable collections for anyone to see. Only admins can write.
    match /{collection:(products|categories|recipes|appearance)}/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isMainAdmin();
    }

    // Users can read/write to their own cart. Admins can access any.
    match /carts/{userId} {
      allow read, write: if isUser(userId) || isAdmin() || isMainAdmin();
    }

    // Users can read/write to their own orders. Admins can access any.
    match /orders/{orderId} {
        allow read, write: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin() || isMainAdmin();
        allow create: if isAuth();
    }

    // Users Collection: 
    // This is the key change to fix the permission paradox.
    match /users/{userId} {
      // An authenticated user can read their OWN document. An admin can read ANY document.
      allow read: if isUser(userId) || isAdmin() || isMainAdmin();
      // An authenticated user can update their OWN document (but not roles).
      allow update: if isUser(userId) && !('roles' in request.resource.data);
      // An admin can update ANY user document, including their roles.
      allow update: if isAdmin() || isMainAdmin();
      // An authenticated user can create their own document.
      allow create: if isUser(userId);
    }
    
    // By default, deny all other access.
    match /{path=**}/documents/{allDocuments=**} {
      allow read, write: if false;
    }
  }
}
