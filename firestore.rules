rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role OR the specific admin email.
    function isAdmin() {
      // Check if the user has the 'admin' role in their user document.
      let hasAdminRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
      // Check if the user's email is the hardcoded admin email.
      let isSuperAdminEmail = request.auth.token.email == 'dhandesaurav52@gmail.com';
      
      return hasAdminRole || isSuperAdminEmail;
    }
    
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    // Publicly readable collections, writable only by admins.
    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read;
      allow write: if isAdmin();
    }

    match /appearance/{docId} {
      allow read;
      allow write: if isAdmin();
    }
    
    match /settings/{docId} {
        allow read, write: if isAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      // Allow users to read their own doc, and admins to read any.
      allow read: if isOwner(userId) || isAdmin();
      // Allow users to update their own doc, but not change their roles.
      // Allow admins to update any doc.
      allow write: if (isOwner(userId) && !("roles" in request.resource.data)) || isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      // Users can read their own orders. Admins can read all orders.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Users can create their own orders. Admins can update any order.
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}
