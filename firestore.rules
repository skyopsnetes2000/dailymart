
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    function isSeller() {
       return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }
    
    function isAuthorizedAdmin() {
        return isMainAdmin() || isAdmin();
    }

    // --- Collections ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /settings/{docId} {
        allow read, write: if isAuthorizedAdmin();
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || isAuthorizedAdmin() || isSeller();
      allow create: if request.auth.uid != null;
      allow update: if isAuthorizedAdmin() || isSeller() || request.auth.uid == resource.data.userId;
    }
    
    match /shopRequests/{requestId} {
        allow read: if isAuthorizedAdmin() || request.auth.uid == resource.data.userId;
        allow create: if request.auth.uid != null;
        allow update: if isAuthorizedAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAuthorizedAdmin();
      allow write: if isAuthorizedAdmin();
      
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAuthorizedAdmin();
    }
  }
}
