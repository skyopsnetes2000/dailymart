
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isMainAdmin() {
        return isAuth() && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function getRoles() {
      // Allow reading user's own roles
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isAdmin() {
      return isAuth() && getRoles().hasAny(['admin']);
    }

    function isSeller() {
      return isAuth() && getRoles().hasAny(['seller']);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Publicly readable collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isMainAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isMainAdmin() || isSeller();
    }

    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isAdmin() || isMainAdmin();
    }
    
    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAdmin() || isMainAdmin();
    }
    
    match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin() || isMainAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isMainAdmin();
      allow create: if isAuth(); // Allow user creation on signup
      allow update: if isOwner(userId) || isAdmin() || isMainAdmin(); // Admins or owners can update
      allow delete: if isAdmin() || isMainAdmin(); // Only admins can delete users
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write, delete: if isOwner(userId);
    }
    
    match /orders/{orderId} {
        allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin() || isMainAdmin() || isSeller();
        allow create: if isAuth(); // Allow users to create their own orders
        allow update: if isAdmin() || isMainAdmin() || isSeller();
    }
    
    match /shopRequests/{requestId} {
        allow read: if isAuth(); // Allow users to read their own request status, and admins to read all
        allow create: if isAuth();
        allow update, delete: if isAdmin() || isMainAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write, create, delete: if isAdmin() || isMainAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write, create, delete: if isAdmin() || isMainAdmin();
    }
  }
}
