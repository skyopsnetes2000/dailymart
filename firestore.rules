
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.roles;
    }
    
    function isAdmin() {
      return isSignedIn() && 'admin' in getRole(request.auth.uid);
    }
    
    // Users can create their own user doc, and can only read/update their own.
    // Admins can read/write any user doc.
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // Products can be read by anyone. Only admins can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories can be read by anyone. Only admins can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Appearance can be read by anyone. Only admins can write.
    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Orders can be read/created by the owner, or read/updated by an admin.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin();
    }

    // Carts can be read/written by the owner.
    match /carts/{userId} {
        allow read, write: if isOwner(userId);
    }

    // Addresses can be read/written by the owner.
    match /users/{userId}/addresses/{addressId} {
        allow read, write: if isOwner(userId);
    }
    
    // Users can create shop requests. Only admins can read/update them.
    match /shopRequests/{requestId} {
        allow create: if isSignedIn() && isOwner(request.resource.data.userId);
        allow read, update: if isAdmin();
    }
    
    // Settings for holidays, etc. Readable by any user, writable only by admins.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Employee and Team data is admin-only.
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }
  }
}
