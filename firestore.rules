rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isMainAdmin() {
      return isAuth() && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
      return isMainAdmin() || (isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'seller']));
    }

    // PUBLIC: Anyone can read these collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true; // Holidays are public
      allow write: if isAdmin();
    }

    // USER-SPECIFIC: Only the owner can read/write their own data
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isAuth();
      // Admins can update user roles
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['roles']);
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }
    
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read, create: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
      allow update: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) || isAdmin();
    }

    // ADMIN: Only admins can access these
    match /shopRequests/{requestId} {
       allow read, create, update: if isAdmin() || isOwner(resource.data.userId);
       allow list: if isAdmin();
    }
    
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }
  }
}