rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for the main admin
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    // Rules for user-specific data
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isMainAdmin();
      allow create: if request.auth.uid == userId;
    }

    match /users/{userId}/addresses/{addressId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Rules for shop applications
    match /shopRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Main admin can read/update any request.
      // A user can read their own request. The query from the client MUST include `where('userId', '==', request.auth.uid)`.
      allow read, update: if isMainAdmin() || request.auth.uid == resource.data.userId;
      // Allow users to query for their own request
      allow list: if isMainAdmin() || (request.auth != null && request.query.get('userId') == request.auth.uid);
    }
    
    // Rules for public or admin-managed content
    match /products/{productId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    match /orders/{orderId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        allow read, update: if isMainAdmin() || request.auth.uid == resource.data.userId;
        allow list: if isMainAdmin() || (request.auth != null && request.query.get('userId') == request.auth.uid);
    }

    match /appearance/{docId} {
        allow read: if true;
        allow write: if isMainAdmin();
    }
    
    match /settings/{docId} {
      allow read, write: if isMainAdmin();
    }
    
    match /employees/{employeeId} {
       allow read, write: if isMainAdmin();
    }
    
    match /teams/{teamId} {
       allow read, write: if isMainAdmin();
    }
  }
}
