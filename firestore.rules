rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    function isAuthorizedAdmin() {
      return isMainAdmin() || isAdmin();
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // --- Public Collections ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // --- User-Specific Collections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthorizedAdmin();
      allow update: if isOwner(userId) && !("roles" in request.resource.data); // User can update profile, but not roles
      allow write: if isAuthorizedAdmin(); // Admin can write/update anything
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/addresses/{addressId} {
        allow read, write: if isOwner(userId);
    }

    // --- Admin-Only Collections ---
    match /orders/{orderId} {
      allow read: if isOwner(request.resource.data.userId) || isAuthorizedAdmin();
      allow create: if isAuth();
      allow update: if isAuthorizedAdmin();
    }
    
    match /settings/{settingId} {
        allow read, write: if isAuthorizedAdmin();
    }

    match /employees/{employeeId} {
        allow read, write: if isAuthorizedAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAuthorizedAdmin();
    }
  }
}
