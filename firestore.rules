rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isMainAdmin() {
        return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let roles = getUserData().roles;
      return isSignedIn() && roles.hasAny(['admin']);
    }
    
    function isSeller() {
        let roles = getUserData().roles;
        return isSignedIn() && roles.hasAny(['seller']);
    }

    // Public Collections (read-only for everyone)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isMainAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSeller() || isMainAdmin();
    }
    
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin() || isMainAdmin();
    }

    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAdmin() || isMainAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin() || isMainAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || isMainAdmin();

      match /addresses/{addressId} {
          allow read, write: if isOwner(userId);
      }
    }

    match /carts/{userId} {
        allow read, write: if isOwner(userId);
    }
    
    match /orders/{orderId} {
        allow read, update: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
        allow create: if isSignedIn();
    }

    // Admin & Seller collections
    match /shopRequests/{requestId} {
        allow read: if isOwner(get(/databases/$(database)/documents/shopRequests/$(requestId)).data.userId) || isAdmin() || isMainAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || isMainAdmin();
    }

    match /employees/{employeeId} {
        allow read, write: if isAdmin() || isMainAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAdmin() || isMainAdmin();
    }
    
    match /settings/{settingId} {
      allow read, write: if isAdmin() || isMainAdmin();
    }
  }
}
