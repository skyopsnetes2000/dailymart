rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user has an 'admin' role
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    // Helper function to check if the user has a 'seller' role
    function isSeller() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }
    
    // Admins and Sellers have broader access
    function isStaff() {
      return isAdmin() || isSeller();
    }

    // --- Publicly readable collections ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isStaff();
    }

    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User-specific collections ---
    match /users/{userId} {
      // Allow a user to read/write their own document
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      // Allow admin to read user data
      allow get: if isAdmin();
    }

    match /carts/{userId} {
      // A user can only access their own cart
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    match /orders/{orderId} {
      // A user can create their own order, and read it afterwards.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow get: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isStaff();
      // Admin/Sellers can view and update all orders
      allow list, update: if isStaff();
    }

    // --- Nested user collections ---
    match /users/{userId}/addresses/{addressId} {
        // A user can manage their own addresses
        allow read, write, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Admin-only or Staff-only collections ---
    match /shopRequests/{requestId} {
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow read, list, update: if isAdmin();
    }

    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
    
    match /settings/{settingId} {
       allow read, write: if isAdmin();
    }
  }
}
