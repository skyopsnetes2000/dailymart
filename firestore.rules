rules_version = '2';

function isMainAdmin() {
  return request.auth.token.email == 'dhandesaurav52@gmail.com';
}

function isAdmin() {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
}

function isSeller() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
}

function isAuthorizedAdmin() {
    return isMainAdmin() || isAdmin();
}

function isOwner(userId) {
  return request.auth.uid == userId;
}

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isAuthorizedAdmin() || isSeller();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthorizedAdmin() || isSeller();
      allow write: if (isOwner(userId) && request.resource.data.keys().hasOnly(['name'])) || isAuthorizedAdmin();
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAuthorizedAdmin() || isSeller();
      allow create: if request.auth != null;
      allow update: if isAuthorizedAdmin() || isSeller() || (isOwner(resource.data.userId) && request.resource.data.status == 'Return Requested');
    }

    // Admin/Seller collections
    match /shopRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAuthorizedAdmin();
      allow create: if request.auth != null;
      allow update: if isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();
    }
    
    match /employees/{employeeId} {
        allow read, write: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
        allow read, write: if isAuthorizedAdmin();
    }

    match /settings/{settingId} {
        allow read, write: if isAuthorizedAdmin();
    }
  }
}