rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin/seller roles
    function isSellerOrAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.roles.hasAny(['admin', 'seller']);
    }

    // Products, Categories, Recipes, and Appearance are public
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
    match /appearance/{docId} {
        allow read: if true;
        allow write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
    
    // Carts: Users can only access their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Orders: Users can read their own orders, and create them. Sellers/Admins can read all.
    match /orders/{orderId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || (request.auth != null && isSellerOrAdmin(request.auth.uid));
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }

    // Users can manage their own document and subcollections
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Addresses: Users can manage their own addresses
      match /addresses/{addressId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shop Requests: Users can create them, Admins/Sellers can manage them
    match /shopRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }

    // Admins/Sellers can manage Employee, Team, and general Settings data
    match /employees/{employeeId} {
        allow read, write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
     match /teams/{teamId} {
        allow read, write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
    match /settings/{settingId} {
       allow read, write: if request.auth != null && isSellerOrAdmin(request.auth.uid);
    }
  }
}