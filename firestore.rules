
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // By default, disallow all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read and list for collections needed by the homepage.
    // Write access is restricted to authenticated users.
    match /products/{productId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }

    match /appearance/{docId} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }

    // Secure user-specific and admin-only data
    match /orders/{orderId} {
      // Allow a user to read/write their own order, or an admin to read/write any order
      allow get, update: if request.auth != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'dhandesaurav52@gmail.com');
      // Allow a user to create their own order
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow admin to list all orders
      allow list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'dhandesaurav52@gmail.com';
    }
  }
}
