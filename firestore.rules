rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isMainAdmin() {
      return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    function isSeller() {
       return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['seller']);
    }
    
    function isAuthorizedAdmin() {
        return isMainAdmin() || isAdmin();
    }
    
    // --- Collection Rules ---

    // PUBLIC: Products, Categories, Recipes, Appearance can be read by anyone.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || isSeller();
    }
    match /appearance/{docId} {
        allow read: if true;
        allow write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
        allow read: if isAuthorizedAdmin();
        allow write: if isAuthorizedAdmin();
    }

    // USER-SPECIFIC: Carts, Orders, and Addresses are private to the user.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /users/{userId}/addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
    }
    
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /orders/{orderId} {
      allow read, create: if request.auth.uid == request.resource.data.userId;
      allow update: if isAuthorizedAdmin() || isSeller(); // For order status updates by admin
      allow read, list: if isAuthorizedAdmin() || isSeller();
    }
    
    // ADMIN/SELLER: Teams and Employees
    match /employees/{employeeId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
