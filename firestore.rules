rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.roles;
    }
    
    function isMainAdmin() {
        return request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    function isAdmin() {
        // Use hasAny to check for 'admin' in the list of roles.
        return getRole(request.auth.uid).hasAny(['admin']);
    }

    function isSeller() {
        // Use hasAny to check for 'seller' or 'admin'
        return getRole(request.auth.uid).hasAny(['seller', 'admin']);
    }

    // Publicly readable collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && (isSeller() || isMainAdmin());
    }
    
    match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }

    match /appearance/{docId} {
        allow read: if true;
        allow write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }
    
    match /settings/{docId} {
      allow read, write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }

    // User-specific collections
    match /users/{userId} {
      allow read, update: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn();
      // Admins can update any user's roles
      allow update: if isSignedIn() && (isAdmin() || isMainAdmin());
    }

    match /carts/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /orders/{orderId} {
      allow create, update: if isSignedIn(); // Allow create/update for authenticated users to place/update their own orders.
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isSeller() || isMainAdmin());
    }
    
    match /shopRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (isAdmin() || isMainAdmin());
    }
    
    match /employees/{employeeId} {
        allow read, write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }

    match /teams/{teamId} {
        allow read, write: if isSignedIn() && (isAdmin() || isMainAdmin());
    }
  }
}
