
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles in ['admin'];
    }

    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
    }

    match /shopRequests/{requestId} {
      allow read: if isAdmin() || get(/databases/$(database)/documents/shopRequests/$(requestId)).data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
    }

    match /carts/{userId} {
      allow read, create, update, delete: if request.auth.uid == userId;
    }
    
    match /users/{userId}/addresses/{addressId} {
      allow read, create, update, delete: if request.auth.uid == userId;
    }
    
    match /orders/{orderId} {
      allow read, create, update, delete: if get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin();
    }

    // Default rules for other collections
    match /{path=**} {
       allow read: if true; // Be cautious with this in production
       allow write: if isAdmin();
    }
  }
}
