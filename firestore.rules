rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Function to check for the main admin by email
    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email == 'dhandesaurav52@gmail.com';
    }

    // Function to get user roles from the 'users' collection
    function getUserRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Function to check if the user has the 'admin' role
    function isAdminRole() {
      return isSignedIn() && 'admin' in getUserRoles();
    }
    
    // Function to check if the user has the 'seller' role
    function isSellerRole() {
      return isSignedIn() && 'seller' in getUserRoles();
    }
    
    // Combined function to authorize any admin type
    function isAuthorizedAdmin() {
      return isMainAdmin() || isAdminRole();
    }
    
    // Combined function for seller/admin write access
    function canWriteContent() {
      return isAuthorizedAdmin() || isSellerRole();
    }

    // --- Collection Rules ---

    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if canWriteContent();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if canWriteContent();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // User-specific collections
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/addresses/{addressId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Orders can be created by users, but only read by owners or admins.
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) || canWriteContent();
      allow update: if canWriteContent();
    }

    // Settings & Admin collections
    match /settings/{settingId} {
        allow read, write: if isAuthorizedAdmin();
    }

    match /employees/{employeeId} {
      allow read, write, delete: if isAuthorizedAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write, delete: if isAuthorizedAdmin();
    }

    match /shopRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isAuthorizedAdmin() || isOwner(get(/databases/$(database)/documents/shopRequests/$(requestId)).data.userId);
      allow update, delete: if isAuthorizedAdmin();
    }
  }
}
