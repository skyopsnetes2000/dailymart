rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin or seller roles
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.roles.hasAny(['admin', 'seller']);
    }

    // Helper function to check if the user is the main admin by email
    function isMainAdmin(auth) {
      return auth.token.email == 'dhandesaurav52@gmail.com';
    }

    // Publicly readable collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }

    // User-specific collections
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isMainAdmin(request.auth);
      allow create: if request.auth.uid == userId; // Allow users to create their own doc
    }
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /orders/{orderId} {
      // Users can read their own orders, admins can read all
      allow read: if request.auth.uid == resource.data.userId || isAdmin(request.auth.uid) || isMainAdmin(request.auth);
      // Users can create orders, admins can update them
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
    }
    
    // Admin-only collections
    match /employees/{employeeId} {
       allow read, write: if isMainAdmin(request.auth);
    }
    match /teams/{teamId} {
       allow read, write: if isMainAdmin(request.auth);
    }
    match /shopRequests/{requestId} {
      allow read: if isAdmin(request.auth.uid) || isMainAdmin(request.auth);
      allow create: if request.auth.uid != null;
      allow update: if isMainAdmin(request.auth);
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
