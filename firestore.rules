
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && 'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Public collections, readable by all
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appearance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-specific data
    match /users/{userId} {
      allow read, update: if isAuthOwner(userId) || isAdmin();
      allow create: if isAuthOwner(userId);
    }
    
    match /carts/{userId} {
      allow read, write: if isAuthOwner(userId);
    }

    match /users/{userId}/addresses/{addressId} {
        allow read, write, delete: if isAuthOwner(userId);
    }

    // Order data
    match /orders/{orderId} {
      allow read, create: if isAuthOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
      allow write: if isAdmin(); // Only admins can update status
    }

    // Admin-only collections
    match /shopRequests/{requestId} {
      allow create: if request.auth != null; // Any authenticated user can create a request.
      allow read, update, delete: if isAdmin();
    }
    
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }
    
    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }
  }
}
