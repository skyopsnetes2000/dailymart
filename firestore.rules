rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      let email = request.auth.token.email;
      return isAuthed() && (
        email == "dhandesaurav52@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']))
      );
    }

    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read;
      allow write: if isAdmin();
    }

    match /appearance/{docId} {
        allow read;
        allow write: if isAdmin();
    }

    match /settings/{docId} {
        allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if (request.auth.uid == userId && !("roles" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if isAuthed();
      allow read, update: if (isAuthed() && request.auth.uid == resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
        allow read, write: if isAdmin();
    }

    match /teams/{teamId} {
        allow read, write: if isAdmin();
    }
  }
}
